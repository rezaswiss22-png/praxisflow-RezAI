# ============================================================
# PRAXISFLOW AI – Umgebungsvariablen (Beispiel)
# Kopiere diese Datei nach .env.local und fülle alle Werte aus.
# NIEMALS .env.local committen!
# ============================================================

# ============================================================
# DATENBANK
# ============================================================
# Lokale Entwicklung mit Docker: postgresql://postgres:postgres@localhost:5432/praxisflow_dev
# Produktion: Verwende einen starken, einzigartigen Passwort
DATABASE_URL="postgresql://DEIN_DB_BENUTZER:DEIN_PASSWORT@localhost:5432/praxisflow_dev"

# ============================================================
# AUTH.JS (v5)
# ============================================================
# Generiere ein sicheres Secret: openssl rand -base64 32
AUTH_SECRET="HIER_EIN_SICHERES_RANDOM_SECRET_EINFUEGEN"

# URL der App (kein trailing slash)
AUTH_URL="http://localhost:3000"

# ============================================================
# ANWENDUNGSUMGEBUNG
# ============================================================
# Mögliche Werte: development | test | production
NODE_ENV="development"

# Pilot-Modus (alle Integrationen sind Mock-Adapter)
PILOT_MODE="true"

# Zeitzone (nicht ändern für CH-Praxen)
TZ="Europe/Zurich"

# ============================================================
# VERSCHLÜSSELUNG (Feldverschlüsselung – vor Echtbetrieb)
# ============================================================
# Generiere: openssl rand -base64 32
# Vor Echtbetrieb: Key Management System (KMS) verwenden
ENCRYPTION_KEY="HIER_32_BYTE_SCHLUESSEL_FUER_FELDVERSCHLUESSELUNG"

# ============================================================
# RATE LIMITING
# ============================================================
# Redis-URL für Rate Limiting (optional in Entwicklung)
# REDIS_URL="redis://localhost:6379"

# Login-Versuche pro 15 Minuten pro IP
RATE_LIMIT_LOGIN="5"
# API-Requests pro Minute pro Benutzer  
RATE_LIMIT_API="200"

# ============================================================
# LOGGING
# ============================================================
# Mögliche Werte: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

# Strukturiertes JSON-Logging (true in Produktion)
LOG_JSON="false"

# ============================================================
# MOCK-ADAPTER KONFIGURATION
# (Alle Werte sind Platzhalter – keine echten APIs im Pilot)
# ============================================================

# Rockethealth [MOCK]
ROCKETHEALTH_MODE="mock"
# ROCKETHEALTH_API_URL=""     # Erst nach API-Dokumentation
# ROCKETHEALTH_API_KEY=""     # Erst nach Vertragsabschluss

# OneDoc [MOCK]
ONEDOC_MODE="mock"
# ONEDOC_WEBHOOK_SECRET=""    # Erst nach API-Dokumentation

# ESPAS [MOCK]
ESPAS_MODE="mock"
# ESPAS_API_URL=""            # Erst nach API-Dokumentation

# HIN/BlueConnect [MOCK]
HIN_MODE="mock"
# HIN_CERTIFICATE_PATH=""     # Erst nach Zertifikatsausstellung
# HIN_CERTIFICATE_PASSWORD="" # Erst nach Zertifikatsausstellung

# E-Mail [MOCK]
EMAIL_MODE="mock"
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM=""
# IMAP_HOST=""
# IMAP_PORT=""
# IMAP_USER=""
# IMAP_PASSWORD=""

# Labor UC-1000/UC-1100 [MOCK]
LABOR_MODE="mock"
# LABOR_HOST=""               # Erst nach Protokolldokumentation

# ============================================================
# FEATURE FLAGS (Pilot)
# ============================================================
# KI-Funktionen aktivieren (regelbasiert im Pilot)
AI_FEATURES_ENABLED="true"

# MFA erzwingen (vor Echtbetrieb auf true setzen)
MFA_REQUIRED="false"

# Audit-Log aktivieren (immer true in Produktion)
AUDIT_LOG_ENABLED="true"

# ============================================================
# SICHERHEITS-HEADERS
# ============================================================
# CORS-Ursprünge (kommagetrennt, kein trailing slash)
CORS_ORIGINS="http://localhost:3000"

# ============================================================
# BACKUP (vor Echtbetrieb konfigurieren)
# ============================================================
# BACKUP_S3_BUCKET=""
# BACKUP_S3_REGION=""
# BACKUP_S3_ACCESS_KEY=""
# BACKUP_S3_SECRET_KEY=""
# BACKUP_ENCRYPTION_KEY=""
