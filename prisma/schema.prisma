// ============================================================
// PRAXISFLOW AI – PRISMA SCHEMA (Pilot v1)
// Version: 1.0.0
// Alle externen Integrationen sind Mock-Adapter (Pilot).
// KEINE echten Patientendaten – ausschliesslich synthetische Testdaten.
// Feldverschlüsselung (AES-256-GCM) ist für sensitive Felder vor
// Echtbetrieb vorgesehen (siehe DATA_MODEL.md, Abschnitt 5).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ARZT
  MPA_EMPFANG
  PRAXISLEITUNG
  PERSONAL
  SYSADMIN
}

enum AuditAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  ESCALATE
}

enum ChannelType {
  ESPAS_PHONE
  ONEDOC_APPOINTMENT
  HIN_EMAIL
  EMAIL
  LABOR
  MANUAL
}

enum EingangStatus {
  NEU
  IN_BEARBEITUNG
  ZUGEORDNET
  ABGESCHLOSSEN
  FEHLER
}

enum Priority {
  URGENT
  HOCH
  MITTEL
  NIEDRIG
}

enum VorgangStatus {
  OFFEN
  IN_BEARBEITUNG
  WARTET
  FREIGABE_ERFORDERLICH
  ABGESCHLOSSEN
  ARCHIVIERT
}

enum TaskStatus {
  OFFEN
  IN_BEARBEITUNG
  ERLEDIGT
  ABGEBROCHEN
}

enum DocType {
  LABORBERICHT
  REZEPT
  UEBERWEISUNG
  BEFUND
  BRIEF
  SONSTIGES
}

enum FreigabeDecision {
  GENEHMIGT
  ABGELEHNT
  ZURUECKGEWIESEN
}

enum AppointmentStatus {
  GEPLANT
  BESTAETIGT
  ABGESAGT
  UMGEPLANT
  ERFOLGT
}

enum CallbackStatus {
  AUSSTEHEND
  GEPLANT
  ERLEDIGT
  ABGEBROCHEN
}

enum AdapterStatus {
  AKTIV
  INAKTIV
  FEHLER
}

enum IntegrationEventStatus {
  AUSSTEHEND
  VERARBEITET
  FEHLGESCHLAGEN
  WIEDERHOLT
}

enum NotificationType {
  INFO
  WARNUNG
  DRINGEND
  AUFGABE
  FREIGABE
}

enum ConsentStatus {
  ERTEILT
  WIDERRUFEN
  AUSSTEHEND
}

// ============================================================
// ORGANISATION & STANDORT
// ============================================================

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("pilot")
  status    String   @default("aktiv")
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  standorte         Standort[]
  users             User[]
  patienten         Patient[]
  eingaenge         Eingang[]
  vorgaenge         Vorgang[]
  tasks             Task[]
  dokumente         Document[]
  appointments      Appointment[]
  callbacks         Callback[]
  channels          Channel[]
  adapters          IntegrationAdapter[]
  integrationEvents IntegrationEvent[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  vorgangCategories VorgangCategory[]
  freigaben         Freigabe[]
  kommentare        Kommentar[]
  consents          Consent[]
  retentionPolicies RetentionPolicy[]
  attachments       Attachment[]

  @@map("organisationen")
}

model Standort {
  id           String       @id @default(cuid())
  tenantId     String
  organisation Organisation @relation(fields: [tenantId], references: [id])
  name         String
  address      String?
  phone        String?
  email        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users        User[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("standorte")
}

// ============================================================
// BENUTZER & AUTH.JS (v5, database sessions)
// ============================================================

model User {
  id            String       @id @default(cuid())
  tenantId      String
  organisation  Organisation @relation(fields: [tenantId], references: [id])
  standortId    String?
  standort      Standort?    @relation(fields: [standortId], references: [id])
  email         String
  emailVerified DateTime?
  name          String
  vorname       String?
  titel         String?
  kuerzel       String?
  passwordHash  String
  role          UserRole     @default(PERSONAL)
  status        String       @default("aktiv")
  aktiv         Boolean      @default(true)
  mfaEnabled    Boolean      @default(false)
  lastLoginAt   DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  sessions           Session[]
  accounts           Account[]
  auditLogs          AuditLog[]
  zugewieseneTasks   Task[]         @relation("TaskAssignee")
  erstellteTasks     Task[]         @relation("TaskCreator")
  vorgaenge          Vorgang[]      @relation("VorgangAssignee")
  freigabenRequested Freigabe[]     @relation("FreigabeRequester")
  freigabenReviewed  Freigabe[]     @relation("FreigabeReviewer")
  kommentare         Kommentar[]
  notifications      Notification[]
  appointments       Appointment[]  @relation("AppointmentProvider")
  callbacks          Callback[]     @relation("CallbackAssignee")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("benutzer")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// AUDIT-LOG (unveränderlich – kein Update, kein Delete)
// ============================================================

model AuditLog {
  id           String       @id @default(cuid())
  tenantId     String
  organisation Organisation @relation(fields: [tenantId], references: [id])
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  action       AuditAction
  resource     String
  resourceId   String?
  before       Json?
  after        Json?
  result       String       @default("erfolg")
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  @@index([tenantId, resource, resourceId])
  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("audit_ereignisse")
}

// ============================================================
// PATIENT
// ============================================================

model Patient {
  id              String        @id @default(cuid())
  tenantId        String
  organisation    Organisation  @relation(fields: [tenantId], references: [id])
  patientenNummer String?
  ahvNr           String? // VERSCHLÜSSELT (im Pilot nicht geseedet)
  firstName       String
  lastName        String
  dateOfBirth     DateTime? // VERSCHLÜSSELT vor Echtbetrieb
  gender          String?
  phone           String? // VERSCHLÜSSELT vor Echtbetrieb
  email           String? // VERSCHLÜSSELT vor Echtbetrieb
  address         Json?
  sprache         String?       @default("de")
  kanton          String?
  status          String        @default("aktiv")
  rockethealthId  String?
  duplicateOfId   String?
  consentStatus   ConsentStatus @default(AUSSTEHEND)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  eingaenge    Eingang[]
  vorgaenge    Vorgang[]
  tasks        Task[]
  dokumente    Document[]
  appointments Appointment[]
  callbacks    Callback[]
  consents     Consent[]

  @@index([tenantId, lastName])
  @@index([tenantId, patientenNummer])
  @@map("patienten")
}

model Consent {
  id           String        @id @default(cuid())
  tenantId     String
  organisation Organisation  @relation(fields: [tenantId], references: [id])
  patientId    String
  patient      Patient       @relation(fields: [patientId], references: [id])
  type         String
  status       ConsentStatus @default(AUSSTEHEND)
  grantedAt    DateTime?
  revokedAt    DateTime?
  legalBasis   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([tenantId, patientId])
  @@map("einwilligungen")
}

model RetentionPolicy {
  id             String       @id @default(cuid())
  tenantId       String
  organisation   Organisation @relation(fields: [tenantId], references: [id])
  resourceType   String
  retentionDays  Int          @default(3650)
  deleteStrategy String       @default("soft")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("aufbewahrungsregeln")
}

// ============================================================
// EINGANG & KANÄLE
// ============================================================

model Channel {
  id           String       @id @default(cuid())
  tenantId     String
  organisation Organisation @relation(fields: [tenantId], references: [id])
  name         String
  type         ChannelType
  config       Json?
  isActive     Boolean      @default(true)
  adapterName  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  eingaenge Eingang[]

  @@unique([tenantId, name])
  @@map("kanaele")
}

model Eingang {
  id              String        @id @default(cuid())
  tenantId        String
  organisation    Organisation  @relation(fields: [tenantId], references: [id])
  channelId       String
  channel         Channel       @relation(fields: [channelId], references: [id])
  patientId       String?
  patient         Patient?      @relation(fields: [patientId], references: [id])
  rawPayload      Json?
  parsedContent   Json?
  subject         String?
  body            String?
  senderName      String?
  senderContact   String?
  attachmentCount Int           @default(0)
  status          EingangStatus @default(NEU)
  aiSuggestion    Json?
  assignedTo      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  processedAt     DateTime?
  deletedAt       DateTime?

  attachments Attachment[]
  vorgaenge   Vorgang[]
  dokumente   Document[]

  @@index([tenantId, status])
  @@map("eingaenge")
}

model Attachment {
  id           String       @id @default(cuid())
  tenantId     String
  organisation Organisation @relation(fields: [tenantId], references: [id])
  eingangId    String
  eingang      Eingang      @relation(fields: [eingangId], references: [id])
  filename     String
  mimeType     String
  size         Int
  storageKey   String
  checksum     String?
  createdAt    DateTime     @default(now())

  @@index([eingangId])
  @@map("anhaenge")
}

// ============================================================
// DOKUMENTE
// ============================================================

model Document {
  id                  String       @id @default(cuid())
  tenantId            String
  organisation        Organisation @relation(fields: [tenantId], references: [id])
  patientId           String?
  patient             Patient?     @relation(fields: [patientId], references: [id])
  vorgangId           String?
  vorgang             Vorgang?     @relation(fields: [vorgangId], references: [id])
  eingangId           String?
  eingang             Eingang?     @relation(fields: [eingangId], references: [id])
  docType             DocType      @default(SONSTIGES)
  title               String
  storageKey          String
  checksum            String?
  mimeType            String       @default("application/pdf")
  size                Int          @default(0)
  pageCount           Int          @default(1)
  aiSuggestion        Json?
  patientZuordnung    String       @default("offen")
  aerztlicheKontrolle Boolean      @default(false)
  status              String       @default("aktiv")
  uploadedBy          String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?

  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@map("dokumente")
}

// ============================================================
// VORGANG
// ============================================================

model VorgangCategory {
  id           String       @id @default(cuid())
  tenantId     String
  organisation Organisation @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  color        String?
  icon         String?
  isDefault    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  vorgaenge Vorgang[]

  @@unique([tenantId, name])
  @@map("vorgang_kategorien")
}

model Vorgang {
  id                   String           @id @default(cuid())
  tenantId             String
  organisation         Organisation     @relation(fields: [tenantId], references: [id])
  nummer               String
  patientId            String?
  patient              Patient?         @relation(fields: [patientId], references: [id])
  eingangId            String?
  eingang              Eingang?         @relation(fields: [eingangId], references: [id])
  categoryId           String?
  category             VorgangCategory? @relation(fields: [categoryId], references: [id])
  title                String
  description          String?
  priority             Priority         @default(MITTEL)
  status               VorgangStatus    @default(OFFEN)
  assignedTo           String?
  assignee             User?            @relation("VorgangAssignee", fields: [assignedTo], references: [id])
  dueDate              DateTime?
  escalatedAt          DateTime?
  escalatedTo          String?
  closedAt             DateTime?
  closedBy             String?
  freigabeErforderlich Boolean          @default(false)
  aiSuggestion         Json?
  version              Int              @default(1)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  tasks      Task[]
  kommentare Kommentar[]
  freigaben  Freigabe[]
  dokumente  Document[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([tenantId, dueDate])
  @@map("vorgaenge")
}

model Task {
  id           String       @id @default(cuid())
  tenantId     String
  organisation Organisation @relation(fields: [tenantId], references: [id])
  vorgangId    String?
  vorgang      Vorgang?     @relation(fields: [vorgangId], references: [id])
  patientId    String?
  patient      Patient?     @relation(fields: [patientId], references: [id])
  title        String
  description  String?
  assignedTo   String?
  assignee     User?        @relation("TaskAssignee", fields: [assignedTo], references: [id])
  assignedBy   String
  creator      User         @relation("TaskCreator", fields: [assignedBy], references: [id])
  priority     Priority     @default(MITTEL)
  status       TaskStatus   @default(OFFEN)
  dueDate      DateTime?
  completedAt  DateTime?
  completedBy  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, assignedTo])
  @@map("aufgaben")
}

model Kommentar {
  id           String       @id @default(cuid())
  tenantId     String
  organisation Organisation @relation(fields: [tenantId], references: [id])
  vorgangId    String
  vorgang      Vorgang      @relation(fields: [vorgangId], references: [id])
  authorId     String
  author       User         @relation(fields: [authorId], references: [id])
  content      String
  isInternal   Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  @@index([vorgangId])
  @@map("kommentare")
}

model Freigabe {
  id           String            @id @default(cuid())
  tenantId     String
  organisation Organisation      @relation(fields: [tenantId], references: [id])
  vorgangId    String
  vorgang      Vorgang           @relation(fields: [vorgangId], references: [id])
  requestedBy  String
  requester    User              @relation("FreigabeRequester", fields: [requestedBy], references: [id])
  reviewedBy   String?
  reviewer     User?             @relation("FreigabeReviewer", fields: [reviewedBy], references: [id])
  typ          String            @default("aerztlich")
  reason       String?
  decision     FreigabeDecision?
  decidedAt    DateTime?
  expiresAt    DateTime?
  createdAt    DateTime          @default(now())

  @@index([tenantId, decision])
  @@map("freigaben")
}

// ============================================================
// TERMINE & RÜCKRUFE
// ============================================================

model Appointment {
  id           String            @id @default(cuid())
  tenantId     String
  organisation Organisation      @relation(fields: [tenantId], references: [id])
  patientId    String?
  patient      Patient?          @relation(fields: [patientId], references: [id])
  providerId   String?
  provider     User?             @relation("AppointmentProvider", fields: [providerId], references: [id])
  standortId   String?
  standort     Standort?         @relation(fields: [standortId], references: [id])
  title        String
  startAt      DateTime
  endAt        DateTime
  status       AppointmentStatus @default(GEPLANT)
  onedocId     String?
  location     String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([tenantId, startAt])
  @@map("termine")
}

model Callback {
  id           String         @id @default(cuid())
  tenantId     String
  organisation Organisation   @relation(fields: [tenantId], references: [id])
  patientId    String?
  patient      Patient?       @relation(fields: [patientId], references: [id])
  requestedBy  String
  phone        String
  reason       String?
  assignedTo   String?
  assignee     User?          @relation("CallbackAssignee", fields: [assignedTo], references: [id])
  status       CallbackStatus @default(AUSSTEHEND)
  scheduledAt  DateTime?
  completedAt  DateTime?
  completedBy  String?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([tenantId, status])
  @@map("rueckrufe")
}

// ============================================================
// INTEGRATIONEN (Mock-Adapter)
// ============================================================

model IntegrationAdapter {
  id              String        @id @default(cuid())
  tenantId        String
  organisation    Organisation  @relation(fields: [tenantId], references: [id])
  name            String
  adapterType     String
  isMock          Boolean       @default(true)
  config          Json?
  credentials     Json? // VERSCHLÜSSELT – im Pilot keine echten Keys
  status          AdapterStatus @default(AKTIV)
  lastHealthCheck DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events IntegrationEvent[]

  @@unique([tenantId, name])
  @@map("integrations_adapter")
}

model IntegrationEvent {
  id             String                 @id @default(cuid())
  tenantId       String
  organisation   Organisation           @relation(fields: [tenantId], references: [id])
  adapterId      String
  adapter        IntegrationAdapter     @relation(fields: [adapterId], references: [id])
  eventType      String
  direction      String
  payload        Json?
  processedAt    DateTime?
  status         IntegrationEventStatus @default(AUSSTEHEND)
  retryCount     Int                    @default(0)
  errorMessage   String?
  idempotencyKey String?                @unique
  createdAt      DateTime               @default(now())

  @@index([adapterId, status])
  @@map("integrations_ereignisse")
}

// ============================================================
// BENACHRICHTIGUNGEN
// ============================================================

model Notification {
  id           String           @id @default(cuid())
  tenantId     String
  organisation Organisation     @relation(fields: [tenantId], references: [id])
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  title        String
  message      String
  type         NotificationType @default(INFO)
  isRead       Boolean          @default(false)
  readAt       DateTime?
  link         String?
  createdAt    DateTime         @default(now())

  @@index([userId, isRead])
  @@map("benachrichtigungen")
}
